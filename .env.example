# Copy to .env.local and fill in after deploying contracts.
# When NEXT_PUBLIC_VERIFIER_ID is set, the app switches from the local demo
# flow to real on-chain claim/init/fund via Freighter.

NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed bounty-verifier contract (C...). Leave empty for demo mode.
NEXT_PUBLIC_VERIFIER_ID=
# Reward token contract (SAC for XLM or a custom token). Needed for init/fund.
NEXT_PUBLIC_TOKEN_ID=
